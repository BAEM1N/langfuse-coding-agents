# Langfuse credentials for langfuse-codex
# Copy this file to ~/.codex/.env and fill in your values.
# Environment variables take priority over .env values.

TRACE_TO_LANGFUSE=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Trace attribution. Set per-host if running on multiple machines (e.g. AgentOS, DefenseOS, FounderOS, RNDOS).
LANGFUSE_USER_ID=codex-user

# Optional
# CC_LANGFUSE_DEBUG=true
# CC_LANGFUSE_MAX_CHARS=20000
# CC_LANGFUSE_HOSTNAME=my-machine
